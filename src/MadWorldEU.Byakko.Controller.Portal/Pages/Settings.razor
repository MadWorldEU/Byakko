@page "/settings"
@attribute [Authorize(Policy = AuthorizationPolicies.User)]
@using MadWorldEU.Byakko.Accounts
@inject IAccountService AccountService
@inject ILogger<Settings> Logger
@inject IStringLocalizer<Resources> Localizer
@inject IErrorTranslator ErrorTranslator

<PageTitle>@Localizer["Brand Name"] – @Localizer["Settings Page Title"]</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="fw-bold mb-1">@Localizer["Settings Heading"]</h2>
            <p class="text-secondary mb-4">@Localizer["Settings Subtitle"]</p>

            @if (_isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@Localizer["Settings Loading"]</span>
                    </div>
                </div>
            }
            else if (_errorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }
            else if (_account is not null)
            {
                <div class="card border-0 bg-body-tertiary mb-3">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold mb-3">@Localizer["Settings Account Status"]</h6>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-secondary small">@Localizer["Settings Deletion Status"]</span>
                            @if (_account.Status == "DeletionRequested")
                            {
                                <span class="badge text-bg-warning">@Localizer["Settings Deletion Requested"]</span>
                            }
                            else if (_account.Status == "DeletionConfirmed")
                            {
                                <span class="badge text-bg-warning">@Localizer["Settings Deletion Confirmed"]</span>
                            }
                            else if (_account.Status == "Deleted")
                            {
                                <span class="badge text-bg-danger">@Localizer["Settings Deleted"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">@Localizer["Settings Active"]</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card border-danger border-opacity-50 bg-body-tertiary">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold text-danger mb-1">@Localizer["Settings Danger Zone"]</h6>
                        <p class="text-secondary small mb-3">@Localizer["Settings Danger Zone Text"]</p>

                        @if (_deletionSuccess)
                        {
                            <div class="alert alert-success mb-0" role="alert">@Localizer["Settings Deletion Success"]</div>
                        }
                        else if (_account.Status != "Active")
                        {
                            <div class="alert alert-warning mb-0" role="alert">@Localizer["Settings Already Requested"]</div>
                        }
                        else if (_deletionErrorMessage is not null)
                        {
                            <div class="alert alert-danger mb-2" role="alert">@_deletionErrorMessage</div>
                            <button class="btn btn-outline-danger btn-sm" @onclick="RequestDeletion">@Localizer["Settings Request Deletion"]</button>
                        }
                        else if (_confirmingDeletion)
                        {
                            <div>
                                <p class="small text-warning mb-2">@Localizer["Settings Confirm Text"]</p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-danger" @onclick="ConfirmDeletionAsync" disabled="@_isRequesting">
                                        @if (_isRequesting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        @Localizer["Settings Confirm Yes"]
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDeletion" disabled="@_isRequesting">@Localizer["Settings Confirm No"]</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="RequestDeletion">@Localizer["Settings Request Deletion"]</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private GetMyAccountResponse? _account;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _deletionErrorMessage;
    private bool _confirmingDeletion;
    private bool _isRequesting;
    private bool _deletionSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AccountService.GetMyAccountAsync();

            if (result.IsSuccess)
            {
                _account = result.Response;
                return;
            }

            if (result.Failure!.StatusCode == 404)
            {
                await CreateAccountAsync();
                return;
            }

            _errorMessage = ErrorTranslator.Translate(result.Failure!);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            _errorMessage = ErrorTranslator.Translate(BlazorErrors.AccountLoadFailed.Code, BlazorErrors.AccountLoadFailed.Description);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAccountAsync()
    {
        try
        {
            var result = await AccountService.CreateMyAccountAsync();

            if (result.IsSuccess)
            {
                var getResult = await AccountService.GetMyAccountAsync();
                if (getResult.IsSuccess)
                {
                    _account = getResult.Response;
                    return;
                }

                _errorMessage = ErrorTranslator.Translate(getResult.Failure!);
            }
            else
            {
                _errorMessage = ErrorTranslator.Translate(result.Failure!);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            _errorMessage = ErrorTranslator.Translate(BlazorErrors.AccountCreateFailed.Code, BlazorErrors.AccountCreateFailed.Description);
        }
    }

    private void RequestDeletion()
    {
        _deletionErrorMessage = null;
        _confirmingDeletion = true;
    }

    private void CancelDeletion()
    {
        _confirmingDeletion = false;
    }

    private async Task ConfirmDeletionAsync()
    {
        _isRequesting = true;
        _deletionErrorMessage = null;

        try
        {
            var result = await AccountService.RequestDeletionMyAccountAsync();

            if (result.IsSuccess)
            {
                _deletionSuccess = true;
                _account = new GetMyAccountResponse { UserId = _account!.UserId, Status = "DeletionRequested" };
            }
            else
            {
                _deletionErrorMessage = ErrorTranslator.Translate(result.Failure!);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            _deletionErrorMessage = ErrorTranslator.Translate(BlazorErrors.AccountDeletionRequestFailed.Code, BlazorErrors.AccountDeletionRequestFailed.Description);
        }
        finally
        {
            _isRequesting = false;
            _confirmingDeletion = false;
        }
    }
}