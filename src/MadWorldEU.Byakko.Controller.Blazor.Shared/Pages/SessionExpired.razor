@page "/session-expired"
@attribute [AllowAnonymous]
@inject IStringLocalizer<SharedResources> Localizer
@inject NavigationManager Navigation

<PageTitle>@Localizer["Brand Name"] – @Localizer["SessionExpired Page Title"]</PageTitle>

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <h1 class="h3 fw-bold mb-2">@Localizer["SessionExpired Heading"]</h1>
    <p class="text-secondary mb-4">@Localizer["SessionExpired Message"]</p>
    <div class="d-flex gap-2 justify-content-center">
        <button class="btn btn-primary fw-semibold" @onclick="LoginAgain">@Localizer["SessionExpired Action"]</button>
        <button class="btn btn-outline-secondary fw-semibold" @onclick="Logout">@Localizer["SessionExpired Logout"]</button>
    </div>
</div>

@code {
    private void LoginAgain()
    {
        Navigation.NavigateToLogout("authentication/logout", "authentication/login?returnUrl=%2F");
    }

    private void Logout()
    {
        Navigation.NavigateToLogout("authentication/logout", "/");
    }
}