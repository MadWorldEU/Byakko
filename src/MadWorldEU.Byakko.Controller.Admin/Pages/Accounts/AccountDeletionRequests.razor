@page "/accounts/deletion-requests"
@attribute [Authorize(Policy = AuthorizationPolicies.Administrator)]
@inject IAccountService AccountService
@inject IErrorTranslator ErrorTranslator
@inject ILogger<AccountDeletionRequests> Logger

<PageTitle>Deletion Requests – Byakko Admin</PageTitle>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Deletion Requests</h1>
        <p class="text-secondary mb-0 small">Accounts that have submitted a GDPR deletion request, 20 per page.</p>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading…</span>
        </div>
    </div>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_response is not null)
{
    @if (_confirmErrorMessage is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_confirmErrorMessage</div>
    }

    <div class="card border-0 bg-body-tertiary">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Username</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _response.Accounts)
                    {
                        <tr>
                            <td class="font-monospace small text-secondary">@account.UserId</td>
                            <td>@account.Username</td>
                            <td>
                                @if (account.Status == "DeletionRequested")
                                {
                                    <span class="badge text-bg-warning">Deletion requested</span>
                                }
                                else if (account.Status == "DeletionConfirmed")
                                {
                                    <span class="badge text-bg-secondary">Deletion confirmed</span>
                                }
                                else if (account.Status == "Deleted")
                                {
                                    <span class="badge text-bg-danger">Deleted</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                            </td>
                            <td class="small">@account.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                @if (_confirmingUserId == account.UserId && account.Status == "DeletionRequested")
                                {
                                    <span class="small text-warning me-2">Confirm deletion?</span>
                                    <button class="btn btn-sm btn-danger me-1"
                                            @onclick="() => ConfirmDeletionAsync(account.UserId)"
                                            disabled="@_confirming">
                                        Yes
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="CancelConfirm"
                                            disabled="@_confirming">
                                        No
                                    </button>
                                }
                                else if (_cancelingUserId == account.UserId && account.Status == "DeletionRequested")
                                {
                                    <span class="small text-info me-2">Cancel deletion request?</span>
                                    <button class="btn btn-sm btn-info me-1"
                                            @onclick="() => CancelDeletionRequestAsync(account.UserId)"
                                            disabled="@_canceling">
                                        Yes
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="CancelCancel"
                                            disabled="@_canceling">
                                        No
                                    </button>
                                }
                                else if (account.Status == "DeletionRequested")
                                {
                                    <button class="btn btn-sm btn-outline-info me-1"
                                            @onclick="() => RequestCancel(account.UserId)">
                                        Cancel request
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RequestConfirm(account.UserId)">
                                        Confirm deletion
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (_response.Accounts.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-secondary py-4">No deletion requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
        <span class="text-secondary small">
            @_response.TotalCount total &middot; Page @_currentPage &middot; @_response.PageSize per page
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(_currentPage <= 1)">Previous</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(!_response.HasNextPage)">Next</button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _errorMessage;
    private string? _confirmErrorMessage;
    private GetAccountsPendingDeletionResponse? _response;
    private int _currentPage = 1;
    private Guid? _confirmingUserId;
    private bool _confirming;
    private Guid? _cancelingUserId;
    private bool _canceling;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var result = await AccountService.GetAccountsPendingDeletionAsync(_currentPage);

            if (result.IsSuccess)
            {
                _response = result.Response;
            }
            else
            {
                _errorMessage = ErrorTranslator.Translate(result.Failure!);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            _errorMessage = ErrorTranslator.Translate(BlazorErrors.AccountLoadFailed.Code, BlazorErrors.AccountLoadFailed.Description);
        }
        finally
        {
            _loading = false;
        }
    }

    private void RequestConfirm(Guid userId)
    {
        _confirmingUserId = userId;
        _cancelingUserId = null;
    }

    private void CancelConfirm()
    {
        _confirmingUserId = null;
    }

    private void RequestCancel(Guid userId)
    {
        _cancelingUserId = userId;
        _confirmingUserId = null;
    }

    private void CancelCancel()
    {
        _cancelingUserId = null;
    }

    private async Task ConfirmDeletionAsync(Guid userId)
    {
        _confirming = true;
        _confirmErrorMessage = null;

        try
        {
            var result = await AccountService.ConfirmDeletionAsync(userId);
            _confirmingUserId = null;

            if (result.IsSuccess)
            {
                await LoadPageAsync();
            }
            else
            {
                _confirmErrorMessage = ErrorTranslator.Translate(result.Failure!);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            _confirmErrorMessage = ErrorTranslator.Translate(BlazorErrors.AccountConfirmDeletionFailed.Code, BlazorErrors.AccountConfirmDeletionFailed.Description);
            _confirmingUserId = null;
        }
        finally
        {
            _confirming = false;
        }
    }

    private async Task CancelDeletionRequestAsync(Guid userId)
    {
        _canceling = true;
        _confirmErrorMessage = null;

        try
        {
            var result = await AccountService.CancelDeletionRequestAsync(userId);
            _cancelingUserId = null;

            if (result.IsSuccess)
            {
                await LoadPageAsync();
            }
            else
            {
                _confirmErrorMessage = ErrorTranslator.Translate(result.Failure!);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            _confirmErrorMessage = ErrorTranslator.Translate(BlazorErrors.AccountCancelDeletionFailed.Code, BlazorErrors.AccountCancelDeletionFailed.Description);
            _cancelingUserId = null;
        }
        finally
        {
            _canceling = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_currentPage <= 1)
        {
            return;
        }

        _currentPage--;
        await LoadPageAsync();
    }

    private async Task NextPageAsync()
    {
        if (_response?.HasNextPage != true)
        {
            return;
        }

        _currentPage++;
        await LoadPageAsync();
    }
}