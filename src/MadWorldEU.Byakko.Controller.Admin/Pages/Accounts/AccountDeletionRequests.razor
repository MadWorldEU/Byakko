@page "/accounts/deletion-requests"
@attribute [Authorize(Policy = AuthorizationPolicies.Administrator)]
@using MadWorldEU.Byakko.Accounts
@using MadWorldEU.Byakko.Accounts.Summaries
@inject IAccountService AccountService
@inject IErrorTranslator ErrorTranslator
@inject ILogger<AccountDeletionRequests> Logger

<PageTitle>Deletion Requests – Byakko Admin</PageTitle>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Deletion Requests</h1>
        <p class="text-secondary mb-0 small">Accounts that have submitted a GDPR deletion request, 20 per page.</p>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading…</span>
        </div>
    </div>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_response is not null)
{
    <div class="card border-0 bg-body-tertiary">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _response.Accounts)
                    {
                        <tr>
                            <td class="font-monospace small text-secondary">@account.UserId</td>
                            <td>
                                @if (account.HasDeletionRequested)
                                {
                                    <span class="badge text-bg-warning">Deletion requested</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (_response.Accounts.Count == 0)
                    {
                        <tr>
                            <td colspan="2" class="text-center text-secondary py-4">No deletion requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
        <span class="text-secondary small">
            @_response.TotalCount total &middot; Page @_currentPage &middot; @_response.PageSize per page
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(_currentPage <= 1)">Previous</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(!_response.HasNextPage)">Next</button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _errorMessage;
    private GetDeleteRequestedAccountsResponse? _response;
    private int _currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var result = await AccountService.GetDeleteRequestedAccountsAsync(_currentPage);

            if (result.IsSuccess)
            {
                _response = result.Response;
            }
            else
            {
                _errorMessage = ErrorTranslator.Translate(result.Failure!);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            _errorMessage = ErrorTranslator.Translate(BlazorErrors.AccountLoadFailed.Code, BlazorErrors.AccountLoadFailed.Description);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_currentPage <= 1)
        {
            return;
        }

        _currentPage--;
        await LoadPageAsync();
    }

    private async Task NextPageAsync()
    {
        if (_response?.HasNextPage != true)
        {
            return;
        }

        _currentPage++;
        await LoadPageAsync();
    }
}